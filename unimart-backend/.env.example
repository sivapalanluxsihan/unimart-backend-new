# .env.example - commit names and safe placeholders only.
# Copy to .env.local for your own reference, but for IntelliJ the values
# below must be entered into Run > Edit Configurations > Environment
# variables (see README.md). Spring Boot does not read a .env file by
# itself unless you add a dotenv library.

DB_URL=jdbc:mysql://127.0.0.1:3306/unimart
DB_USERNAME=unimart_app
DB_PASSWORD=change-me
JWT_SECRET=replace-with-base64-secret
JWT_ACCESS_MINUTES=15
APP_ALLOWED_ORIGINS=http://localhost:5174
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
